<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Create Event - Upload Image</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="main-header">
    <div class="logo">Our logo</div>
    <div class="header-center">
      <input type="text" placeholder="Search events..." class="search-bar" />
      <select class="location-dropdown">
        <option>Choose location</option>
      </select>
    </div>
    <nav class="nav-links">
      <a href="#">Home</a>
      <a href="#">Events</a>
      <a href="#">Profile</a>
      <a href="#">My Bookings</a>
      <a href="#">Sign Up</a>
      <a href="#">Login</a>
    </nav>
  </header>

  <section class="form-section">
    <h1>Create a New Event</h1>
    <h3>Upload Image</h3>
    <form>
      <div class="form-row">
        <input type="file" accept="image/png, image/jpeg, image/gif" />
      </div>
      <p class="info-text">
        Feature Image must be at least 1170 pixels wide by 504 pixels high.<br>
        Valid file formats: JPG, GIF, PNG.
      </p>
      <button class="primary-button">Save & Continue</button>
    </form>
  </section>
</body>
</html>
