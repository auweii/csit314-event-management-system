<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create Event</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- Header -->
  <header class="site-header">
    <div class="header-left">
      <div class="logo">Our logo</div>
      <input type="text" class="search-box" placeholder="Search events..." />
      <select class="location-dropdown">
        <option>Choose location</option>
      </select>
    </div>
    <div class="header-right">
      <a href="#">Home</a>
      <a href="#">Events</a>
      <a href="#">Profile</a>
      <a href="#">My Bookings</a>
      <a href="#">Sign Up</a>
      <a href="#">Login</a>
    </div>
  </header>

  <div class="container">
    <h1 class="page-title">
      <span class="back-arrow">←</span> EVENT CREATED!
    </h1>
    
    

    <div class="review-box"></div>

    <div class="main-layout">
      <!-- Left Column -->
      <div class="left-column">
        <h2 class="event-title">TITLE of event</h2>

        <div class="info-section">
          <div class="date-time">
            <p>📅 Saturday, April 27, 2025</p>
            <p>⏰ 7:00 PM </p>
            <a href="#">+ Add to Calendar</a>

            <div class="hosted">
              <p>Hosted by</p>
             
              <span>Jazz Sydney Collective</span>
            </div>
          </div>

          <div class="description">
            <label for="desc">Event description:</label>
            <textarea id="desc" readonly>Enjoy an unforgettable night of smooth jazz under the stars
at our rooftop venue. Featuring some of the city's most talented jazz musicians, this event promises to bring good vibes, great music, and an unbeatable atmospher.</textarea>
          </div>
        </div>
      </div>

      <!-- Middle Column (Tickets) -->
      <div class="middle-column">
        <button class="buy-ticket">🎟️ Buy Tickets</button>

        <div class="ticket-info">
          <p><strong>Ticket Information</strong></p>
          <p>✅ Standard Ticket: $ 280 each</p>
        </div>

        <div class="location">
          <p><strong>Location</strong></p>
          <p>123 Jazz St, Sydney</p>
        </div>
      </div>

      <!-- Right Column (Buttons) -->
      <div class="right-column">
        
        </div>

      
    </div>
  </div>
</body>
</html>
